{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "backend/**",
        "data/**",
        "frontend/**",
        "report_templates/**",
        "report_styles/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
